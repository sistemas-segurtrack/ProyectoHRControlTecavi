APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Inertia DevTools (Chrome extension). Empty = local only; false = off.
INERTIA_DEVTOOLS_ENABLED=true

# Cuenta admin sembrada por AdminUserSeeder (ver config/services.php). Sin
# ADMIN_PASSWORD, el seeder usa un valor de relleno obviamente falso — nunca
# dejar la contraseña real de un entorno escrita en el código.
ADMIN_EMAIL=desarrollo@segurtrack.com
ADMIN_PASSWORD=

# Wialon (PWA Conductor)
WIALON_BASE_URL=https://hst-api.wialon.com
WIALON_STK_TOKEN=
WIALON_STK_RESOURCE=TECAVI
WIALON_CONTADOR_KM_UNIDADES=

# Prefijo de la PWA Conductor. Vacío en local y si el dominio de producción
# sirve la app en su raíz o en un subdominio propio. Si va detrás de un proxy
# en subpath (p. ej. tools.segurtrack.com/hrcontrol), poner "/hrcontrol" en
# ambas — PWA_BASE_PATH la usa el backend (manifest, service worker),
# VITE_PWA_BASE_PATH se hornea en el bundle de la PWA al compilar (build ARG
# del Dockerfile, no re-configurable sin reconstruir la imagen).
PWA_BASE_PATH=
VITE_PWA_BASE_PATH=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Fija — no derivada de APP_NAME. Si otra app en el mismo dominio comparte el
# nombre de cookie, el navegador manda las dos y el login falla sin error
# visible (nos pasó en el proyecto hermano shalom el 2026-09-04).
SESSION_COOKIE=hrcontrol_session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: 'log' escribe los correos a storage/logs/laravel.log. Para verlos
# renderizados con Mailpit (DDEV lo trae integrado):
#   MAIL_MAILER=smtp
#   MAIL_HOST=localhost
#   MAIL_PORT=1025
# y abrir `ddev launch -m`.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@segurtrack.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Producción (VPS) ------------------------------------------------------
# Referencia para el .env real del servidor — ver DEPLOY-VPS.md. No editar
# estas líneas aquí; son solo para copiar/pegar al configurar el VPS.
#
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tools.segurtrack.com/hrcontrol
# ASSET_URL=https://tools.segurtrack.com/hrcontrol
# PWA_BASE_PATH=/hrcontrol
# VITE_PWA_BASE_PATH=/hrcontrol
# APP_TIMEZONE=America/Lima
# APP_PORT=8090
#
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=hrcontrol_db
# DB_USERNAME=sistemas-segurtrack
# DB_PASSWORD=                 # openssl rand -base64 24
# DB_ROOT_PASSWORD=            # openssl rand -base64 24 (otro valor)
#
# MAIL_MAILER=smtp
# MAIL_HOST=mail.segurtrack.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps            # TLS implícito; si el servidor solo hace STARTTLS: MAIL_ENCRYPTION=tls MAIL_PORT=587
# MAIL_USERNAME=no-reply@segurtrack.com
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="no-reply@segurtrack.com"
